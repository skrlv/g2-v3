# PostgreSQL — строка подключения (на проде возьмите её в Neon / Railway)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Пароль для входа в /admin и изменения каталога (логин любой).
# На проде обязателен: без него студия отвечает «выключена», а не открывается всем.
ADMIN_PASSWORD=

# Адрес сайта для ссылок в превью соцсетей, например https://g2wear.ru
NEXT_PUBLIC_SITE_URL=

# Уведомления о заказах и сообщениях в Telegram (необязательно).
# Токен выдаёт @BotFather; chat id — ваш числовой id после первого сообщения боту
# (см. https://api.telegram.org/bot<токен>/getUpdates, поле chat.id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Хранилище фото из студии (см. DEPLOY.md, раздел «Фото») ---
# Вариант 1: S3-совместимое (Yandex Object Storage, Selectel, VK Cloud, R2, MinIO).
# Обязательно для Vercel и любого serverless-хостинга.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-central1
# Публичный адрес бакета (без завершающего слэша), например https://storage.yandexcloud.net/g2
S3_PUBLIC_URL=
# Вариант 2: папка на диске (Docker/VPS). В Dockerfile уже задан /app/uploads — примонтируйте том.
UPLOADS_DIR=
# Ничего не задано — фото сохраняются в базе как data-URL (работает, но тяжело).

# --- Письмо покупателю после заказа (любой SMTP: Яндекс 360, Mail.ru, Timeweb) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Отправитель, например "G2 <studio@g2wear.ru>"
MAIL_FROM=

# --- Аналитика: номер счётчика Яндекс.Метрики ---
NEXT_PUBLIC_YM_ID=
# Вебвизор записывает экраны покупателей — включайте, только если это отражено в политике конфиденциальности
NEXT_PUBLIC_YM_WEBVISOR=false
